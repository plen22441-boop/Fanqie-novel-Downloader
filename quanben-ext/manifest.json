{
  "manifest_version": 3,
  "name": "Novel Downloader — Universal",
  "version": "2.0.0",
  "description": "ดาวน์โหลดนิยายจากทุกเว็บ — ปุ่มลอย, Fast Fetch, ไล่ตอนอัตโนมัติ",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
